{
	"name": "cider-sdk",
	"version": "2.0.0",
	"description": "Control Cider from your own apps and scripts: read what's playing, browse the library, fetch lyrics, run playback, and more, over a local API on your machine.",
	"keywords": [
		"cider",
		"applemusic",
		"music"
	],
	"homepage": "https://github.com/AsakiYuki/cider-sdk#readme",
	"bugs": {
		"url": "https://github.com/AsakiYuki/cider-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AsakiYuki/cider-sdk.git"
	},
	"license": "MIT",
	"author": "Asaki Yuki",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "bun run test/index.ts",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build:esm": "tsc -p tsconfig.esm.json",
		"build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').mkdirSync('dist/cjs',{recursive:true});require('node:fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
		"build": "bun run clean && bun run build:esm && bun run build:cjs",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^5.9.3"
	}
}
